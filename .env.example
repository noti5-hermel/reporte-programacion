# Vacío = rutas relativas. En Docker, nginx proxyiza /api/ y /auth-api/.
VITE_API_BASE_URL=
VITE_REPORTS_API_URL=
VITE_AUTH_API_URL=
VITE_AUTH_HEALTH_URL=
VITE_AUTH_FRONTEND_URL=

# Ejemplos para desarrollo sin proxy:
# VITE_API_BASE_URL=http://localhost:8000
# VITE_REPORTS_API_URL=http://localhost:8107
# VITE_AUTH_API_URL=http://localhost:8001
# VITE_AUTH_HEALTH_URL=http://localhost:8081/api/auth/health
# VITE_AUTH_FRONTEND_URL=http://localhost:5173

# Upstreams usados por nginx dentro del contenedor (en tiempo de ejecución):
# REPORTS_API_UPSTREAM=http://reports-api:8107
# AUTH_API_UPSTREAM=http://auth-api:8081
